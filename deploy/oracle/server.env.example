# Copy to server.env on the VM and fill in. Never commit server.env.

# Public HTTPS name for the API. Without your own domain use the VM's public
# IP with dashes plus sslip.io, e.g. 129-146-10-20.sslip.io
API_DOMAIN=

APP_ENV=production
CORS_ORIGINS=https://new-x1.pages.dev

# Supabase (same values as the website's NEXT_PUBLIC_* variables)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Release bucket, READ-ONLY credentials (s3:GetObject and s3:ListBucket on the prefix)
RELEASE_BUCKET=
RELEASE_PREFIX=new-x1
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RELEASE_POLL_SECONDS=300
