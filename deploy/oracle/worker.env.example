# Copy to worker.env on the VM. Used only by the scheduled refresh worker.
APP_ENV=production

# Release bucket, WRITE-capable credentials (GetObject, PutObject, ListBucket on the prefix)
RELEASE_BUCKET=
RELEASE_PREFIX=new-x1
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fixture and squad providers
CRICKET_DATA_API_KEY=
RAPID_API_KEY=
