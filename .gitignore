data/processed/*.csv
data/processed/*.parquet
data/processed/player_fantasy_points_*.json
data/processed/*aggregate_data.json

# ── Model artifacts (large binaries) ──────────────────────────────────────
model_artifacts/*.pkl
model_artifacts/ProductUI_Model

