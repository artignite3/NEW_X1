# NEW_X1 — Environment Variables
# Copy this file to .env and fill in your values

# ── Cricket Data API (for live squad data) ───────────────────────────────────
# Get your free key from: https://cricketdata.org
CRICKET_DATA_API_KEY=

# ── RapidAPI Cricbuzz (full fixture window + squads) ─────────────────────────
# Subscribe (free plan available) at rapidapi.com -> "Cricbuzz Cricket" API
RAPID_API_KEY=

# ── Open-Meteo (weather) ─────────────────────────────────────────────────────
# No key needed — free API, no auth required
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# ── Ollama (local LLM for AI analyst explanations) ───────────────────────────
# Make sure Ollama is running: ollama serve
# Model pulled:               ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Anti-leakage training cutoff ─────────────────────────────────────────────
TRAIN_CUTOFF=2025-06-30
