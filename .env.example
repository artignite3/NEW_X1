# NEW_X1 — Environment Variables
# Copy this file to .env and fill in your values

# ── Cricket Data API (for live squad data) ───────────────────────────────────
# Get your free key from: https://cricketdata.org
CRICKET_DATA_API_KEY=

# ── RapidAPI Cricbuzz (full fixture window + squads) ─────────────────────────
# Subscribe (free plan available) at rapidapi.com -> "Cricbuzz Cricket" API
RAPID_API_KEY=

# ── Open-Meteo (weather) ─────────────────────────────────────────────────────
# No key needed — free API, no auth required
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# ── Ollama (local LLM for AI analyst explanations) ───────────────────────────
# Make sure Ollama is running: ollama serve
# Model pulled:               ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Anti-leakage training cutoff ─────────────────────────────────────────────
TRAIN_CUTOFF=2025-06-30

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication is required in staging/production and whenever Supabase is configured.
APP_ENV=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PHONE_AUTH_ENABLED=false
# Local development state; deployed accounts always use Supabase RLS storage.
APP_STATE_PATH=outputs/app_state.sqlite

# Isolated scheduled refresh; the release worker sets PIPELINE_STAGING=true.
# Leave roots absent for the repository defaults; use absolute paths to override.
# NEW_X1_DATA_ROOT=
# NEW_X1_MODEL_ROOT=
SQUAD_REQUEST_BUDGET=3
